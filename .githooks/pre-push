#!/bin/bash
# Blocks a push of any branch that does not contain the latest origin/main,
# unless the branch is stacked on another open branch.
# Tags and deletions are not checked.
set -uo pipefail

zero=0000000000000000000000000000000000000000

if ! git fetch --quiet --no-auto-maintenance --no-auto-gc origin main; then
  echo "pre-push: could not fetch origin/main; push not checked" >&2
  exit 0
fi

# Prints the first branch on origin, other than main and the branch being
# pushed, that the commit builds on and origin/main does not contain.
stacked_on() {
  local sha=$1 pushed=$2 ref branch

  for ref in $(git for-each-ref --format='%(refname)' --merged "$sha" refs/remotes/origin/); do
    branch=${ref#refs/remotes/origin/}
    case $branch in main | HEAD | "$pushed") continue ;; esac

    if git merge-base --is-ancestor "$ref" origin/main; then
      continue
    fi

    if git ls-remote --exit-code --heads origin "$branch" >/dev/null; then
      echo "$branch"
      return
    fi
  done
}

status=0
while read -r local_ref local_sha remote_ref _; do
  case $remote_ref in refs/heads/*) ;; *) continue ;; esac
  if [ "$local_sha" = "$zero" ] || git merge-base --is-ancestor origin/main "$local_sha"; then
    continue
  fi

  parent=$(stacked_on "$local_sha" "${remote_ref#refs/heads/}")
  if [ -n "$parent" ]; then
    echo "pre-push: $local_ref is stacked on $parent, so it is not checked against origin/main" >&2
    continue
  fi

  echo "Push blocked: $local_ref does not contain origin/main. Merge origin/main into it, then push again." >&2
  status=1
done
exit $status
